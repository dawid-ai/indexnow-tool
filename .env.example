# App settings. Projects and IndexNow keys are managed in the UI
# (Projects & keys page) and stored in the database, not here.

# Where the database lives. Defaults to data/indexnow.db when running from a
# checkout, or ~/.indexnow/indexnow.db for an installed `indexnow` command.
DB_PATH=data/indexnow.db

DEFAULT_ENDPOINT=indexnow
DEFAULT_UI_PORT=8787

# --- Access control ---------------------------------------------------------
# Required for any instance reachable beyond localhost. The app refuses to start
# on a non-loopback host without it, because the database holds your IndexNow
# keys in plaintext.
# AUTH_PASSWORD=change-me

# Optional. Signs session cookies. Leave unset and a new one is generated per
# start, which signs everyone out on restart. Set it to keep sessions across
# restarts, and set it if you ever run more than one worker or replica, since
# each process would otherwise reject the others' cookies.
# AUTH_SECRET=some-long-random-string

# Set to true when serving over HTTPS, so the session cookie is HTTPS-only.
# AUTH_COOKIE_SECURE=false

# --- Legacy project definitions --------------------------------------------
# Imported into the database on startup only if no project of that name exists,
# so edits made in the UI always win.
# PROJECTS=demo
# PROJECT_DEMO_HOST=www.example.com
# PROJECT_DEMO_KEY=90d0eecfb5144dc4bdbb41c28fd71a15
# PROJECT_DEMO_KEY_LOCATION=https://www.example.com/90d0eecfb5144dc4bdbb41c28fd71a15.txt
# PROJECT_DEMO_SITEMAP_URL=https://www.example.com/sitemap.xml
# PROJECT_DEMO_DEFAULT_ENDPOINT=indexnow
